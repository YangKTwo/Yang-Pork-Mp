@import '/styles/common.wxss';

/* Vant Weapp 主题 · 对齐 docs/design/11_vant_weapp_design_align.md · primary #C62828（内联，避免 Win DevTools 相对 @import miss） */
page {
  --button-primary-background-color: #C62828;
  --button-primary-border-color: #C62828;
  --button-danger-background-color: #D32F2F;
  --button-danger-border-color: #D32F2F;
  --switch-on-background-color: #C62828;
  --radio-checked-icon-color: #C62828;
  --checkbox-checked-icon-color: #C62828;
  --stepper-button-icon-color: #C62828;
  --tabs-default-color: #C62828;
  --tab-active-text-color: #C62828;
  --tag-primary-color: #C62828;
  --submit-bar-price-color: #C62828;
  --submit-bar-button-background-color: #C62828;
  --dialog-confirm-button-text-color: #C62828;
  --field-input-text-color: #1A1A1A;
  --cell-text-color: #1A1A1A;
  --cell-label-color: #666666;
  background: #FAF7F5;
  color: #1A1A1A;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  line-height: 1.45;
  min-height: 100%;
  box-sizing: border-box;
}

.mp-cart-submit {
  bottom: calc(112rpx + env(safe-area-inset-bottom)) !important;
}

.mp-page-foot {
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
}

.mp-popup-foot {
  padding: 16rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}
