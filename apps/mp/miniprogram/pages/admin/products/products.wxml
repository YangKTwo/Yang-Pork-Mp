<view class="page" style="padding:16rpx 0 48rpx">
  <view style="padding:0 32rpx 24rpx">
    <button class="btn-primary" bindtap="openCreate">新建商品</button>
  </view>
  <view class="card" wx:for="{{list}}" wx:key="id">
    <view class="row">
      <text style="font-weight:500">{{item.name}}</text>
      <text class="badge {{item.status==='ON_SHELF'?'ok':'muted'}}">{{item.status==='ON_SHELF'?'上架':'下架'}}</text>
    </view>
    <view class="muted">{{item.skuCode}} · ¥{{item.priceYuan}}/{{item.unit}}</view>
    <view class="muted" wx:if="{{item.remark}}" style="margin-top:8rpx">{{item.remark}}</view>
    <view class="btn-row" style="margin-top:16rpx">
      <button class="btn-secondary" size="mini" data-id="{{item.id}}" bindtap="openEdit">编辑</button>
      <button
        wx:if="{{item.status!=='ON_SHELF'}}"
        class="btn-secondary"
        size="mini"
        data-id="{{item.id}}"
        data-status="ON_SHELF"
        bindtap="toggleShelf"
      >上架</button>
    </view>
  </view>
</view>

<view class="mask" wx:if="{{showForm}}" catchtouchmove="noop">
  <view class="sheet" style="max-height:88vh;overflow-y:auto">
    <view class="handle"></view>
    <view style="text-align:center;font-size:34rpx;font-weight:600;margin-bottom:24rpx">
      {{formMode === 'create' ? '新建商品' : '编辑商品'}}
    </view>
    <view class="field">
      <label>名称 <text class="req">*</text></label>
      <input placeholder="如：精瘦肉" value="{{form.name}}" data-k="name" bindinput="onFormField" />
    </view>
    <view class="field">
      <label>单位 <text class="req">*</text></label>
      <picker mode="selector" range="{{unitOptions}}" value="{{unitIndex}}" bindchange="onUnitPick">
        <view class="row" style="padding:16rpx 0;border-bottom:1rpx solid #E8E0DC">
          <text>{{form.unit}}</text>
          <text class="muted">选择</text>
        </view>
      </picker>
    </view>
    <view class="field">
      <label>标价（元） <text class="req">*</text></label>
      <input type="digit" placeholder="如 15" value="{{form.priceYuan}}" data-k="priceYuan" bindinput="onFormField" />
    </view>
    <view class="field">
      <label>商品备注（可选）</label>
      <textarea
        placeholder="约重等说明，如：约 1.2–1.5 斤/条，以店内为准"
        value="{{form.remark}}"
        data-k="remark"
        bindinput="onFormField"
        maxlength="200"
        style="width:100%;min-height:120rpx;padding:16rpx;box-sizing:border-box;border:1rpx solid #E8E0DC;border-radius:12rpx"
      />
    </view>
    <view class="field">
      <view class="row" style="padding:8rpx 0">
        <text style="font-weight:500">上架</text>
        <switch checked="{{onShelf}}" bindchange="onShelfSwitch" color="#C62828" />
      </view>
      <view class="tiny">关 = 下架；下架商品在列表仍可见，顾客端不展示</view>
    </view>
    <view wx:if="{{formMode === 'edit'}}" style="margin-bottom:24rpx">
      <view class="formula-hint" style="margin:0 0 16rpx">
        <text class="muted">删除即下架（列表仍可见），与现网一致。</text>
      </view>
      <button class="btn-ghost-danger" bindtap="shelfOffAndSave" loading="{{formLoading}}">下架并保存</button>
    </view>
    <view class="btn-row">
      <button class="btn-secondary" bindtap="closeForm">取消</button>
      <button
        class="btn-primary {{canSubmitForm ? '' : 'disabled'}}"
        disabled="{{!canSubmitForm}}"
        bindtap="submitForm"
        loading="{{formLoading}}"
      >保存</button>
    </view>
  </view>
</view>
