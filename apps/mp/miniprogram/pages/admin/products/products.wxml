<view class="page" style="padding:16rpx 0 48rpx">
  <view style="padding:0 32rpx 24rpx">
    <van-button type="primary" block round bind:click="openCreate">新建商品</van-button>
  </view>
  <van-cell-group inset wx:for="{{list}}" wx:key="id" custom-class="product-group">
    <van-cell use-label-slot>
      <view slot="title" class="row" style="padding:0">
        <text style="font-weight:500">{{item.name}}</text>
        <van-tag type="{{item.status==='ON_SHELF'?'success':'default'}}" plain size="medium">
          {{item.status==='ON_SHELF'?'上架':'下架'}}
        </van-tag>
      </view>
      <view slot="label">
        <view class="muted">{{item.skuCode}} · ¥{{item.priceYuan}}/{{item.unit}}</view>
        <view class="muted" wx:if="{{item.remark}}" style="margin-top:8rpx">{{item.remark}}</view>
        <view class="btn-row" style="margin-top:16rpx">
          <van-button size="small" plain hairline data-id="{{item.id}}" bind:click="openEdit">编辑</van-button>
          <van-button
            wx:if="{{item.status!=='ON_SHELF'}}"
            size="small"
            type="primary"
            plain
            hairline
            data-id="{{item.id}}"
            data-status="ON_SHELF"
            bind:click="toggleShelf"
          >上架</van-button>
        </view>
      </view>
    </van-cell>
  </van-cell-group>
</view>

<van-popup show="{{showForm}}" position="bottom" round bind:close="closeForm" closeable custom-style="max-height:88vh">
  <view class="sheet-inner">
    <view style="text-align:center;font-size:34rpx;font-weight:600;margin-bottom:24rpx">
      {{formMode === 'create' ? '新建商品' : '编辑商品'}}
    </view>
    <van-cell-group>
      <van-field
        label="名称"
        required
        placeholder="如：精瘦肉"
        value="{{form.name}}"
        data-k="name"
        bind:change="onFormField"
      />
      <picker mode="selector" range="{{unitOptions}}" value="{{unitIndex}}" bindchange="onUnitPick">
        <van-cell title="单位" required is-link value="{{form.unit}}" />
      </picker>
      <van-field
        label="标价（元）"
        required
        type="digit"
        placeholder="如 15"
        value="{{form.priceYuan}}"
        data-k="priceYuan"
        bind:change="onFormField"
      />
      <van-field
        label="商品备注"
        type="textarea"
        placeholder="约重等说明，如：约 1.2–1.5 斤/条，以店内为准"
        value="{{form.remark}}"
        data-k="remark"
        maxlength="200"
        autosize
        bind:change="onFormField"
      />
      <van-cell title="上架" use-label-slot>
        <van-switch slot="right-icon" checked="{{onShelf}}" bind:change="onShelfSwitch" size="24px" />
      </van-cell>
      <view class="tiny" style="padding:0 32rpx 16rpx">关 = 下架；下架商品在列表仍可见，顾客端不展示</view>
    </van-cell-group>
    <view wx:if="{{formMode === 'edit'}}" style="margin:0 32rpx 24rpx">
      <view class="formula-hint" style="margin:0 0 16rpx">
        <text class="muted">删除即下架（列表仍可见），与现网一致。</text>
      </view>
      <van-button type="danger" plain block loading="{{formLoading}}" bind:click="shelfOffAndSave">下架并保存</van-button>
    </view>
    <view class="btn-row mp-popup-foot">
      <van-button plain hairline custom-style="flex:1" bind:click="closeForm">取消</van-button>
      <van-button
        type="primary"
        custom-style="flex:1;margin-left:20rpx"
        disabled="{{!canSubmitForm}}"
        loading="{{formLoading}}"
        bind:click="submitForm"
      >保存</van-button>
    </view>
  </view>
</van-popup>
