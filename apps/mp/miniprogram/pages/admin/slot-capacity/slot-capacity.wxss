.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.slot-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #E8E0DC;
}
.slot-row:last-child {
  border-bottom: none;
}
.slot-meta {
  flex: 1;
  min-width: 0;
}
.slot-name {
  font-size: 30rpx;
  font-weight: 500;
}
.slot-eff {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}
.cap-input {
  width: 140rpx;
  height: 72rpx;
  text-align: center;
  border: 1rpx solid #E8E0DC;
  border-radius: 16rpx;
  font-size: 30rpx;
  background: #fff;
}
.cap-unit {
  font-size: 26rpx;
  color: #666;
  width: 36rpx;
}
.date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid #E8E0DC;
  border-radius: 16rpx;
  background: #fff;
  font-size: 30rpx;
  margin-bottom: 16rpx;
}
.date-row .val {
  font-weight: 500;
}
.link-danger {
  display: block;
  width: 100%;
  margin-top: 16rpx;
  padding: 24rpx;
  border: none;
  background: transparent;
  color: #D32F2F;
  font-size: 28rpx;
  text-align: center;
}
.hint-box {
  margin-top: 24rpx;
}
.card-gap {
  margin-bottom: 24rpx;
}
