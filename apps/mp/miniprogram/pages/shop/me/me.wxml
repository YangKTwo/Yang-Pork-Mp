<view class="page" style="padding-top:24rpx;padding-bottom:140rpx">
  <van-cell-group inset>
    <van-cell title="角色" value="{{role}}" />
    <van-cell title="姓名" value="{{user.realName || '—'}}" />
  </van-cell-group>
  <view class="muted" style="margin:24rpx 32rpx">店家/超管账号由超管配置；顾客端入口见首页 Mock 切换。</view>
  <view style="padding:0 32rpx">
    <van-button type="danger" plain block bind:click="logout">退出</van-button>
  </view>
</view>
<role-tabbar tabs="{{tabs}}" bind:select="onTab" />
