/* P0：双分区视觉分隔（保留自定义 seg，分区底色区分） */
.work-zone {
  margin-top: 8rpx;
  padding-bottom: 16rpx;
}
.preorder-zone {
  background: transparent;
}
.manual-zone {
  background: #F3ECE8;
  margin: 0 24rpx;
  border-radius: 24rpx;
  padding-top: 16rpx;
  border: 1rpx solid #E8E0DC;
}
.tag-gap {
  margin-left: 8rpx;
}
