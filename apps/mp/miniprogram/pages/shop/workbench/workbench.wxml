<view class="page" style="padding-bottom:140rpx">
  <!-- P0：预定 / 代录双分区自定义 seg -->
  <view class="seg">
    <view class="seg-item {{tab==='preorder'?'on':''}}" data-tab="preorder" bindtap="switchTab">预定</view>
    <view class="seg-item {{tab==='manual'?'on':''}}" data-tab="manual" bindtap="switchTab">代录</view>
  </view>

  <slot-picker mode="filter" options="{{slotFilters}}" value="{{slotFilter}}" bind:pick="switchSlotFilter" />

  <view wx:if="{{tab==='preorder'}}" class="work-zone preorder-zone">
    <view class="card" wx:for="{{preorderList}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="row">
        <status-tag text="{{item.statusText}}" type="{{item.statusTagType}}" />
        <status-tag text="{{item.pickupSlotLabel}}" gap="{{true}}" />
        <text class="tiny">码 {{item.pickupCode || '—'}}</text>
      </view>
      <view class="row"><text>{{item.realName}}</text><text>{{item.phone}}</text></view>
      <view class="muted">{{item.pickupSlotText}} · {{item.summary}} · ¥{{item.totalYuan}}</view>
      <view class="muted" wx:if="{{item.remark}}" style="margin-top:8rpx">备注：{{item.remark}}</view>
    </view>
    <page-empty wx:if="{{!preorderList.length}}" description="暂无预定订单" />
  </view>

  <view wx:else class="work-zone manual-zone">
    <view style="padding:0 32rpx 16rpx">
      <van-button type="primary" plain hairline block round bind:click="goManualCreate">新建代录</van-button>
    </view>
    <view class="card" wx:for="{{manualList}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="row">
        <status-tag text="代录" />
        <status-tag text="{{item.statusText}}" type="{{item.statusTagType}}" gap="{{true}}" />
        <status-tag text="{{item.pickupSlotLabel}}" gap="{{true}}" />
      </view>
      <view class="row"><text>{{item.realName}}</text><text>{{item.phone}}</text></view>
      <view class="muted">{{item.pickupSlotText}} · {{item.summary}} · ¥{{item.totalYuan}}</view>
      <view class="muted" wx:if="{{item.remark}}" style="margin-top:8rpx">备注：{{item.remark}}</view>
    </view>
    <page-empty wx:if="{{!manualList.length}}" description="暂无代录订单" />
  </view>
</view>

<role-tabbar tabs="{{tabs}}" bind:select="onTab" />
