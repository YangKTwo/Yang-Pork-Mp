<view class="page" style="padding:24rpx 0 160rpx">
  <van-cell-group inset>
    <van-field label="姓名" required placeholder="顾客姓名" value="{{realName}}" bind:change="onName" />
    <van-field label="手机" required type="number" maxlength="11" placeholder="11 位手机号" value="{{phone}}" bind:change="onPhone" />
    <van-field label="取货日" placeholder="YYYY-MM-DD" value="{{pickupDate}}" bind:change="onDate" />
  </van-cell-group>
  <van-cell-group inset title="取货时段（必选）">
    <slot-picker options="{{slotOptions}}" value="{{pickupSlot}}" hint="{{slotHint}}" bind:pick="onPickSlot" />
  </van-cell-group>
  <van-cell-group inset>
    <picker range="{{productNames}}" value="{{productIndex}}" bindchange="onPick">
      <van-cell title="商品" is-link value="{{productNames[productIndex] || '选择商品'}}" />
    </picker>
    <picker range="{{depositOptions}}" value="{{depositIndex}}" bindchange="onDeposit">
      <van-cell title="线下定金" is-link value="{{depositOptions[depositIndex]}}" />
    </picker>
    <van-field label="备注" placeholder="电话预定等" value="{{remark}}" bind:change="onRemark" />
  </van-cell-group>
</view>
<page-foot>
  <van-button type="primary" block round loading="{{loading}}" bind:click="onSubmit">提交代录</van-button>
</page-foot>
