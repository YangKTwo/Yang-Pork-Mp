<view class="page" style="padding-bottom:160rpx">
  <van-cell-group inset title="取货信息">
    <van-cell title="取货日" value="{{pickupDate}}" />
    <van-cell title="取货方式" value="到店自取" />
  </van-cell-group>
  <van-cell-group inset title="取货时段（必选）">
    <view class="seg slot-seg">
      <view
        wx:for="{{slotOptions}}"
        wx:key="code"
        class="seg-item {{pickupSlot===item.code?'on':''}} {{item.full?'disabled':''}}"
        data-slot="{{item.code}}"
        data-full="{{item.full}}"
        bindtap="onPickSlot"
      >{{item.label}}</view>
    </view>
    <view class="formula-hint slot-hint" wx:if="{{slotHint}}">{{slotHint}}</view>
  </van-cell-group>
  <van-cell-group inset title="明细">
    <van-cell
      wx:for="{{lines}}"
      wx:key="id"
      title="{{item.name}} ×{{item.quantity}} {{item.unit}}"
      value="¥{{item.lineYuan}}"
    />
    <van-cell title="订单金额" value="¥{{totalYuan}}" value-class="price" />
    <van-cell wx:if="{{needDeposit}}" title="预计定金" value="¥{{depositYuan}}" value-class="price" />
    <van-cell wx:else title="定金" value="免定金（≤门槛）" />
  </van-cell-group>
  <view class="formula-hint" style="margin:0 32rpx 16rpx">{{formulaText}}</view>
  <van-cell-group inset>
    <van-field
      label="备注"
      type="textarea"
      placeholder="口味/切法偏好，选填"
      value="{{remark}}"
      autosize
      bind:change="onRemark"
    />
  </van-cell-group>
</view>
<view class="foot-safe">
  <van-button type="primary" block round loading="{{loading}}" disabled="{{!canOrder}}" bind:click="onSubmit">提交订单</van-button>
</view>
