<view class="content" style="padding-top:24rpx">
  <view class="card">
    <view class="muted" style="margin-bottom:24rpx">请填写真实姓名与手机号，便于到店取货核验。昵称将由系统生成。</view>
    <view class="field">
      <label>姓名</label>
      <input placeholder="请输入真实姓名" value="{{realName}}" bindinput="onName" maxlength="20" />
    </view>
    <view class="field">
      <label>手机号</label>
      <input type="number" placeholder="11 位手机号" value="{{phone}}" bindinput="onPhone" maxlength="11" />
    </view>
    <button class="btn-primary" bindtap="onSubmit" disabled="{{!canSubmit}}" loading="{{loading}}">提交并进入</button>
  </view>
</view>
