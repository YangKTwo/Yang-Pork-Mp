<view class="content" style="padding-top:24rpx">
  <view class="muted" style="margin:0 32rpx 24rpx">请填写真实姓名与手机号，便于到店取货核验。昵称将由系统生成。</view>
  <van-cell-group inset>
    <van-field
      label="姓名"
      placeholder="请输入真实姓名"
      value="{{realName}}"
      maxlength="20"
      bind:change="onName"
    />
    <van-field
      label="手机号"
      type="number"
      placeholder="11 位手机号"
      value="{{phone}}"
      maxlength="11"
      bind:change="onPhone"
    />
  </van-cell-group>
  <view class="mp-page-foot">
    <van-button type="primary" block round disabled="{{!canSubmit}}" loading="{{loading}}" bind:click="onSubmit">提交并进入</van-button>
  </view>
</view>
