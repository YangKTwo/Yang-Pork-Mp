<view class="page" wx:if="{{order}}">
  <view class="card" style="text-align:center">
    <status-tag text="{{statusText}}" type="{{statusTagType}}" />
    <view class="muted" wx:if="{{closedDetailNote}}" style="margin-top:16rpx;text-align:center">{{closedDetailNote}}</view>
    <view wx:if="{{subscribeReminderOn}}" class="subscribe-reminder">
      <text class="badge ok">{{subscribeBadge}}</text>
      <view class="muted" style="margin-top:16rpx;text-align:center">{{subscribeHint}}</view>
    </view>
    <pickup-code
      code="{{order.pickupCode}}"
      pending="{{order.status === 'PENDING_PAY'}}"
      hint="到店出示此码，并报姓名与手机号"
    />
  </view>
  <van-cell-group inset>
    <van-cell title="取货时段" value="{{pickupSlotText}}" />
    <van-cell title="取货日" value="{{order.pickupDate}}" />
    <van-cell title="取货方式" value="到店自取" />
    <van-cell title="定金" value="{{depositText}}" />
    <van-cell wx:if="{{order.remark}}" title="备注" value="{{order.remark}}" />
  </van-cell-group>
  <view class="formula-hint" style="margin:0 32rpx 16rpx">{{order.depositFormulaText}}</view>
  <van-cell-group inset title="明细">
    <van-cell
      wx:for="{{order.items}}"
      wx:key="productId"
      title="{{item.name}} ×{{item.quantity}} {{item.unit}}"
      value="¥{{item.lineYuan}}"
    />
    <van-cell title="订单金额" value="¥{{totalYuan}}" value-class="price" />
  </van-cell-group>
  <view style="padding:0 32rpx">
    <van-button
      wx:if="{{showSubscribeOffer}}"
      type="primary"
      plain
      block
      loading="{{subscribing}}"
      bind:click="onEnableSubscribe"
    >开启可取货提醒</van-button>
    <van-button wx:if="{{canCancel}}" type="danger" plain block bind:click="openCancel">取消订单</van-button>
    <view class="tiny" style="text-align:center;padding:16rpx 0 32rpx" wx:if="{{canCancel}}">
      仅下单当日 22:00（含）前可自助取消
    </view>
  </view>
</view>

<van-dialog
  show="{{showCancel}}"
  title="确认取消订单"
  message="今日 22:00 前可取消。取消后已付定金将原路退回。取消后不可恢复，如需请重新下单。"
  show-cancel-button
  async-close
  confirm-button-text="确认取消"
  cancel-button-text="再想想"
  confirm-button-color="#D32F2F"
  bind:cancel="closeCancel"
  bind:confirm="confirmCancel"
/>
