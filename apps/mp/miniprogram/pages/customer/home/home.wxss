.nav-extra { padding: 0 32rpx 8rpx; text-align: right; }
.banner {
  margin: 0 32rpx 24rpx; padding: 24rpx 28rpx; border-radius: 20rpx;
  background: #FFEBEE; color: #C62828; font-size: 26rpx; font-weight: 500;
  display: flex; gap: 16rpx; align-items: flex-start;
}
.banner.off { background: #eee; color: #666; }
.banner .dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: currentColor; margin-top: 10rpx; flex-shrink: 0; }
.strong { font-weight: 700; }
.item {
  display: flex; align-items: center; gap: 24rpx;
  background: #fff; border: 1rpx solid #E8E0DC; border-radius: 20rpx;
  padding: 24rpx; margin: 0 32rpx 20rpx; min-height: 144rpx;
}
.thumb {
  width: 112rpx; height: 112rpx; border-radius: 16rpx; flex-shrink: 0;
  background: linear-gradient(160deg, #f5e6e0, #e8cfc6);
  display: flex; align-items: center; justify-content: center; font-size: 44rpx;
}
.info { flex: 1; min-width: 0; }
.name { font-size: 32rpx; font-weight: 500; }
.meta { font-size: 24rpx; color: #999; margin-top: 4rpx; }
.add {
  width: 72rpx !important; height: 72rpx; border-radius: 50%; border: none;
  background: #C62828; color: #fff; font-size: 44rpx; line-height: 72rpx; padding: 0;
}
.sheet-head { display: flex; justify-content: space-between; align-items: flex-start; }
.qty { display: flex; align-items: center; gap: 28rpx; margin: 32rpx 0; }
.qty-val { font-size: 36rpx; font-weight: 600; min-width: 80rpx; text-align: center; }
.cartbar {
  position: fixed; left: 24rpx; right: 24rpx; bottom: 130rpx; z-index: 60;
  background: #2a2422; color: #fff; border-radius: 56rpx;
  padding: 16rpx 16rpx 16rpx 36rpx; display: flex; align-items: center; justify-content: space-between;
}
.cartbar .go {
  background: #C62828; border: none; color: #fff; border-radius: 44rpx;
  height: 80rpx; line-height: 80rpx; padding: 0 36rpx; font-size: 28rpx; margin: 0;
}
