<view class="page" style="padding-bottom: {{cartCount ? 280 : 140}}rpx">
  <view class="nav-extra tiny">次日取货 {{config.nextPickupDate || '—'}}</view>
  <view class="banner" wx:if="{{config.canOrderNow}}">
    <view class="dot"></view>
    <view>可下单时段 <text class="strong">{{config.orderWindowStart}}–{{config.orderWindowEnd}}</text>（含）· 当前可下单</view>
  </view>
  <view class="banner off" wx:else>
    <view class="dot"></view>
    <view>当前不在下单窗口（{{config.orderWindowStart}}–{{config.orderWindowEnd}}），暂不可下单</view>
  </view>

  <view class="item" wx:for="{{products}}" wx:key="id">
    <view class="thumb">{{item.name[0]}}</view>
    <view class="info">
      <view class="name">{{item.name}}</view>
      <view class="meta">{{item.remark || ('按' + item.unit)}}</view>
      <view class="price">¥{{item.priceYuan}}<text class="tiny"> /{{item.unit}}</text></view>
    </view>
    <van-button
      type="primary"
      size="small"
      round
      icon="plus"
      custom-class="add-btn"
      data-id="{{item.id}}"
      disabled="{{!config.canOrderNow}}"
      bind:click="openDrawer"
    />
  </view>
</view>

<van-popup show="{{drawerOpen}}" position="bottom" round bind:close="closeDrawer" closeable>
  <view class="sheet-inner" wx:if="{{drawerProduct}}">
    <view class="sheet-head">
      <view>
        <view style="font-size:34rpx;font-weight:600">{{drawerProduct.name}}</view>
        <view class="price" style="margin-top:8rpx">¥{{drawerProduct.priceYuan}} /{{drawerProduct.unit}}</view>
      </view>
    </view>
    <view class="qty-row">
      <text class="muted">数量</text>
      <van-stepper
        value="{{qty}}"
        min="{{drawerMin}}"
        step="{{drawerStep}}"
        decimal-length="{{drawerDecimal}}"
        bind:change="onQtyChange"
      />
    </view>
    <view class="muted">小计 ¥{{lineYuan}}</view>
    <van-button type="primary" block round custom-style="margin-top:24rpx" bind:click="addCart">加入待下单</van-button>
  </view>
</van-popup>

<van-submit-bar
  wx:if="{{cartCount > 0}}"
  custom-class="mp-cart-submit"
  label="已选 {{cartCount}} 件"
  price="{{cartPriceFen}}"
  button-text="去下单"
  disabled="{{!config.canOrderNow}}"
  bind:submit="goConfirm"
/>

<view class="tabbar-mock">
  <view class="tab on"><text class="ico">⌂</text>商品</view>
  <view class="tab" bindtap="goOrders"><text class="ico">☰</text>订单</view>
  <view class="tab" bindtap="goMe"><text class="ico">☺</text>我的</view>
</view>
