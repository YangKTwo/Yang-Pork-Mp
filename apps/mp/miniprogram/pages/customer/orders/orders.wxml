<view class="page" style="padding-bottom:140rpx;padding-top:16rpx">
  <block wx:if="{{list.length}}">
    <van-cell-group inset wx:for="{{list}}" wx:key="id" custom-class="order-group">
      <van-cell
        is-link
        use-label-slot
        value="¥{{item.totalYuan}}{{item.pickupCode ? ' · 码 ' + item.pickupCode : ''}}"
        bind:click="goDetail"
        data-id="{{item.id}}"
      >
        <view slot="title">
          <status-tag text="{{item.statusText}}" type="{{item.statusTagType}}" size="medium" />
          <text class="muted"> {{item.pickupSlotText}}</text>
        </view>
        <view slot="label">{{item.subscribeReminderOn ? item.subscribeBadge + ' · ' + item.summary : item.summary}}</view>
      </van-cell>
    </van-cell-group>
  </block>
  <page-empty wx:else description="暂无订单" />
</view>
<role-tabbar tabs="{{tabs}}" bind:select="onTab" />
