<view class="page" style="padding-bottom:140rpx;padding-top:16rpx">
  <block wx:if="{{list.length}}">
    <van-cell-group inset wx:for="{{list}}" wx:key="id" custom-class="order-group">
      <van-cell
        is-link
        title="{{item.statusText}} · {{item.pickupSlotText}}"
        label="{{item.summary}}"
        value="¥{{item.totalYuan}}{{item.pickupCode ? ' · 码 ' + item.pickupCode : ''}}"
        bind:click="goDetail"
        data-id="{{item.id}}"
      />
    </van-cell-group>
  </block>
  <van-empty wx:else description="暂无订单" />
</view>
<view class="tabbar-mock">
  <view class="tab" bindtap="goHome"><text class="ico">⌂</text>商品</view>
  <view class="tab on"><text class="ico">☰</text>订单</view>
  <view class="tab" bindtap="goMe"><text class="ico">☺</text>我的</view>
</view>
